---
import { navigation } from '../../data/navigation';
const current = Astro.url.pathname;
---
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4">
    <a href="/" class="text-lg font-semibold">Alejandro Tapia</a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap gap-4 text-sm">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.href ? 'page' : undefined}
              class="hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-blue-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>