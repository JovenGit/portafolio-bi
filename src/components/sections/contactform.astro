---
import { profile } from '../../data/profile';

const field =
  'mt-1.5 block w-full rounded-lg border border-line bg-bg px-3 py-2.5 text-fg placeholder:text-muted focus:border-accent';
---

<div id="contact-root">
  <form
    id="contact-form"
    name="contacto"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class="space-y-5"
  >
    <input type="hidden" name="form-name" value="contacto" />

    <!-- Trampa anti-spam: los humanos no la ven, los bots la llenan -->
    <div hidden>
      <label>
        No completar: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div>
      <label for="nombre" class="text-sm font-medium">
        Nombre
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        autocomplete="name"
        maxlength="100"
        class={field}
      />
    </div>

    <div>
      <label for="email" class="text-sm font-medium">
        Correo electrónico
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="150"
        class={field}
      />
    </div>

    <div>
      <label for="mensaje" class="text-sm font-medium">
        Mensaje
      </label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="6"
        required
        maxlength="2000"
        class={field}
      ></textarea>
    </div>

    <p
      id="contact-error"
      role="alert"
      hidden
      class="rounded-lg border border-line bg-surface p-3 text-sm text-red-700 dark:text-red-300"
    >
      No se pudo enviar el mensaje. Inténtalo de nuevo o escríbeme directamente a
      <a href={`mailto:${profile.links.email}`} class="font-medium underline">
        {profile.links.email}
      </a>
      .
    </p>

    <button
      id="contact-submit"
      type="submit"
      class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-colors hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span id="contact-submit-label">Enviar mensaje</span>
    </button>
  </form>

  <div id="mail-scene" class="mail-scene" hidden aria-hidden="true">
    <div class="mail-flight">
      <div class="envelope">
        <div class="env-flap"></div>
        <div class="env-front"></div>
        <div class="letter"></div>
        <div class="env-back"></div>
      </div>
    </div>
    <p class="mail-caption">Enviando tu carta…</p>
  </div>

  <div
    id="contact-success"
    role="status"
    tabindex="-1"
    hidden
    class="rounded-xl border border-line bg-surface p-10 text-center"
  >
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">Mensaje enviado</p>
    <h2 class="mt-2 text-2xl font-bold">¡Gracias por escribirme!</h2>
    <p class="mx-auto mt-2 max-w-md text-muted">
      Recibí tu mensaje y te responderé al correo que indicaste lo antes posible.
    </p>
    <button
      id="contact-reset"
      type="button"
      class="mt-6 inline-flex items-center justify-center rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-fg hover:bg-bg"
    >
      Enviar otro mensaje
    </button>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const scene = document.getElementById('mail-scene');
  const success = document.getElementById('contact-success');
  const errorBox = document.getElementById('contact-error');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('contact-submit-label');
  const resetBtn = document.getElementById('contact-reset');

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function send(data: FormData) {
    if (import.meta.env.DEV) {
      await wait(700);
      return;
    }
    const body = new URLSearchParams(data as unknown as Record<string, string>).toString();
    const response = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    });
    if (!response.ok) throw new Error(`Error ${response.status}`);
  }

  if (form && scene && success && errorBox && submitBtn && submitLabel && resetBtn) {
    const setSending = (sending: boolean) => {
      submitBtn.disabled = sending;
      submitLabel.textContent = sending ? 'Enviando…' : 'Enviar mensaje';
    };

    async function playLetter() {
      form!.hidden = true;
      if (prefersReducedMotion()) return;
      scene!.hidden = false;
      scene!.classList.remove('play');
      void scene!.offsetWidth; 
      scene!.classList.add('play');
      await wait(3200);
      scene!.hidden = true;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      setSending(true);

      try {
        await send(new FormData(form));
      } catch {
        errorBox.hidden = false;
        setSending(false);
        return;
      }

      await playLetter();
      success.hidden = false;
      success.focus();
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      setSending(false);
      success.hidden = true;
      form.hidden = false;
      document.getElementById('nombre')?.focus();
    });
  }
</script>

<style>
  .mail-scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 22rem;
    overflow: hidden; 
  }
  .mail-scene[hidden] {
    display: none;
  }

  .mail-caption {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .envelope {
    position: relative;
    width: 240px;
    height: 160px;
    perspective: 700px;
  }

  .env-back,
  .env-front,
  .env-flap,
  .letter {
    position: absolute;
  }

  .env-back {
    inset: 0;
    z-index: 1;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 22%, var(--bg));
    border: 2px solid var(--accent);
  }

  .letter {
    top: 0;
    left: 20px;
    width: 200px;
    height: 64px;
    z-index: 2;
    box-sizing: border-box;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #f8fafc; 
    transform: translateY(-84px); 
  }
  .letter::before {
    content: '';
    display: block;
    height: 100%;
    background: repeating-linear-gradient(to bottom, #94a3b8 0 2px, transparent 2px 10px);
  }

  .env-front {
    inset: 0;
    z-index: 3;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 40%, var(--bg));
    clip-path: polygon(0 0, 50% 55%, 100% 0, 100% 100%, 0 100%);
  }

  .env-flap {
    top: 0;
    left: 0;
    width: 100%;
    height: 88px; 
    z-index: 0;
    background: color-mix(in srgb, var(--accent) 55%, var(--bg));
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: top center;
    transform: rotateX(180deg); /* abierta */
  }

  .mail-scene.play .mail-flight {
    animation:
      mail-in 0.4s ease-out both,
      mail-fly 1.1s ease-in 2s forwards;
  }
  .mail-scene.play .letter {
    animation: letter-in 1s ease-in-out 0.2s forwards;
  }
  .mail-scene.play .env-flap {
    animation: flap-close 0.6s ease-in-out 1.3s forwards;
  }

  @keyframes mail-in {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes letter-in {
    from {
      transform: translateY(-84px);
    }
    to {
      transform: translateY(90px);
    }
  }

  @keyframes flap-close {
    0% {
      transform: rotateX(180deg);
      z-index: 0;
    }
    49% {
      z-index: 0;
    }
    50% {
      transform: rotateX(90deg);
      z-index: 4;
    }
    100% {
      transform: rotateX(0deg);
      z-index: 4;
    }
  }

  @keyframes mail-fly {
    0% {
      transform: translate(0, 0) rotate(0) scale(1);
      opacity: 1;
    }
    20% {
      transform: translate(-6px, 8px) rotate(-3deg) scale(1.02);
      opacity: 1;
    }
    100% {
      transform: translate(280px, -230px) rotate(16deg) scale(0.3);
      opacity: 0;
    }
  }
</style>
