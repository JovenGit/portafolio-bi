---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { profile } from '../../data/profile';
---

<section class="border-b border-line">
  <Container class="py-16 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">{profile.field}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">{profile.name}</h1>
    <p class="mt-2 text-xl font-medium text-muted md:text-2xl">{profile.role}</p>
    <p class="mt-6 max-w-2xl text-lg text-muted">{profile.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={profile.links.github} variant="secondary">
        GitHub
      </Button>
      <Button href={`mailto:${profile.links.email}`} variant="secondary">
        Escribirme
      </Button>
    </div>
  </Container>
</section>
