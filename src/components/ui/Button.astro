---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}
const { href, variant = 'primary' } = Astro.props;
const external = href.startsWith('http');

const base =
  'inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors';
const variants = {
  primary: 'bg-accent text-on-accent hover:opacity-90',
  secondary: 'border border-line text-fg hover:bg-surface',
};
---

<a
  href={href}
  class:list={[base, variants[variant]]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
