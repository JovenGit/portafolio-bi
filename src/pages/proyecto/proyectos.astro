---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de análisis de datos y desarrollo web de Alejandro Tapia."
>
  <Container class="py-12 md:py-16">
    <SectionHeading
      level="h1"
      title="Proyectos"
      subtitle="Lo que he construido: análisis de datos, dashboards y desarrollo web."
    />
    <ul class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </Container>
</BaseLayout>