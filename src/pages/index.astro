---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Inicio">
  <Container class="py-16 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      Business Intelligence · Ingeniería en Programación
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Alejandro Tapia</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Analista e ingeniero de datos. Analizo la vulnerabilidad territorial de Colchagua
      con ETL, modelado, DAX y forecast.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/proyecto">Ver el proyecto</Button>
      <Button href="/contacto" variant="secondary">Contacto</Button>
    </div>
  </Container>
</BaseLayout>