---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactForm from '../components/sections/contactform.astro';
import { profile } from '../data/profile';
---
<BaseLayout
  title="Contacto"
  description="Escríbeme para conversar sobre análisis de datos, Business Intelligence o una oportunidad de trabajo."
>
  <Container class="py-12 md:py-16">
    <SectionHeading
      level="h1"
      title="Contacto"
      subtitle="¿Tienes una pregunta o una oportunidad? Escríbeme y te respondo por correo."
    />

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <ContactForm />
      </div>

      <Card as="div" class="h-fit">
        <h2 class="text-lg font-semibold">También puedes encontrarme en</h2>
        <div class="mt-4 flex flex-col gap-3">
          <Button href={profile.links.github} variant="secondary">GitHub</Button>
          <Button href={`mailto:${profile.links.email}`} variant="secondary">Correo directo</Button>
        </div>
      </Card>
    </div>
  </Container>
</BaseLayout>